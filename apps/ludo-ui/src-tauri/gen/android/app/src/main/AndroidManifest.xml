<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lancement sans aucun sélecteur de dossier (android.rs) : ROM lues par chemin (Documents/Roms) et
         confiées par le FileProvider aux émulateurs sans arbre (Dolphin). Accordé par le PC par adb
         (`appops set <paquet> MANAGE_EXTERNAL_STORAGE allow` : scripts/apk.sh, ludo adb-watch), jamais
         demandé par l'app. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Retour sensoriel (feedback.ts → rumble.rs → LudoPlugin.vibrer) : moteur de vibration de l'appareil. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mise à jour depuis l'app (MiseAJourApk.kt) : APK de la release confié à l'installeur d'Android. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Menu en jeu (MenuJeuPlugin.kt) : « Reprendre » ouvre l'activité de lanceur de l'émulateur
         (getLaunchIntentForPackage), visible seulement par cette déclaration. -->
    <!-- Retour après une partie (RetourService.kt) : reconnaître le lanceur HOME (Cocoon) et la
         bibliothèque de l'émulateur (activité de lanceur). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <!-- Retour après une partie (RetourService.kt) : second filet pour remettre la Ludothèque devant
         depuis l'arrière-plan. Accordé par le PC (adb `appops set <paquet> SYSTEM_ALERT_WINDOW allow`,
         scripts/apk.sh, ludo adb-sync), jamais demandé par l'app ; aucune fenêtre superposée n'est dessinée. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ludo_ui"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Retour à la Ludothèque en un appui après une partie qu'elle a lancée (Mode, HOME, jeu quitté).
             Changements de fenêtre seulement : aucune touche, aucun contenu d'écran. Activé par le PC (adb). -->
        <service
            android:name=".RetourService"
            android:exported="false"
            android:label="@string/retour_service_nom"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/retour_service" />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
