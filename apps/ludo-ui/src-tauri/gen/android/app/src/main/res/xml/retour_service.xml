<?xml version="1.0" encoding="utf-8"?>
<!-- Retour après une partie (RetourService.kt) : changements de fenêtre seulement. Ni filtre de touches,
     ni contenu d'écran (canRetrieveWindowContent absent). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:description="@string/retour_service_description"
    android:summary="@string/retour_service_resume" />
